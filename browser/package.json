{
    "name": "flexigo-browser",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "build:win": "electron-builder --win --dir",
        "build:linux": "electron-builder --linux --dir",
        "build:mac": "electron-builder --mac --dir"
    },
    "build": {
        "appId": "com.flexigo.browser",
        "productName": "flexigo-browser",
        "directories": {
            "output": "../bin/browser"
        },
        "win": {
            "target": "portable"
        },
        "linux": {
            "target": "dir"
        },
        "mac": {
            "target": "dir"
        }
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12"
    }
}
